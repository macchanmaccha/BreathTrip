                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "MeditationJourney.xcodeproj",
                "-scheme",
                "MeditationJourney",
                "clean"
